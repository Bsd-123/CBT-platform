# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Used solely to look up recipients' email addresses (kept in Supabase Auth)
# and who favorited an event, for the notification emails below. Never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom endpoint
# R2_UPLOAD_ENDPOINT=

# Public site URL (branded links and email logo URLs).
# NEXT_PUBLIC_SITE_URL=

# Public contact address shown on the contact and accessibility pages.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Transactional email (Resend). Emails are switched off unless ALL of RESEND_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY and NEXT_PUBLIC_SITE_URL are set.
# RESEND_API_KEY=
# Verified sender, e.g. "קהילת מטפלי CBT <no-reply@your-domain.com>". Defaults to Resend's test
# sender onboarding@resend.dev, which only delivers to your own Resend account address.
# EMAIL_FROM=

# Optional: promote existing users to admin when running `npm run db:seed`.
# FIRST_ADMIN_USER_IDS=uuid-user-1,uuid-user-2

# Local development only, on networks that intercept TLS. Refused in production.
# ALLOW_INSECURE_TLS=true

# Optional: shared rate limiting across server instances (Upstash Redis REST).
# Without these the limiter is per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
