# Optional: promote existing users to admin when running `npm run db:seed`.
# Users must already exist in the `users` table (same UUID as Supabase Auth).
#
# Multiple admins (comma-separated):
# FIRST_ADMIN_USER_IDS=uuid-user-1,uuid-user-2
#
# Single admin (legacy):
# FIRST_ADMIN_USER_ID=

# Public site URL (used after deploy for branded links and email logo URLs).
# Dev: http://localhost:3000
# Production: https://your-domain.com
# NEXT_PUBLIC_SITE_URL=
