# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only; currently unused by the app - leave unset unless needed.
# SUPABASE_SERVICE_ROLE_KEY=

# Prisma / PostgreSQL (Supabase)
# Pooled connection for runtime (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Direct connection for migrations (port 5432)
DIRECT_URL=

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom endpoint
# R2_UPLOAD_ENDPOINT=

# Public site URL (branded links and email logo URLs).
# NEXT_PUBLIC_SITE_URL=

# Optional: promote existing users to admin when running `npm run db:seed`.
# FIRST_ADMIN_USER_IDS=uuid-user-1,uuid-user-2

# Local development only, on networks that intercept TLS. Refused in production.
# ALLOW_INSECURE_TLS=true
